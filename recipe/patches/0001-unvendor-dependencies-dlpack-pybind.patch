Subject: [PATCH 1/2] unvendor dependencies: dlpack, pybind

---
 setup.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 9eee3697..1ef11d67 100644
--- a/setup.py
+++ b/setup.py
@@ -43,11 +43,13 @@ class CMakeBuild(build_ext):
             # All these are handled by pip
             f"-DCMAKE_LIBRARY_OUTPUT_DIRECTORY={extdir}{os.sep}",
             f"-DCUDNN_FRONTEND_KEEP_PYBINDS_IN_BINARY_DIR=OFF",
+            f"-DCUDNN_FRONTEND_USE_SYSTEM_DLPACK=ON",
+            f"-DCUDNN_FRONTEND_FETCH_PYBINDS_IN_CMAKE=OFF",
         ]
 
         if is_windows:
             cmake_args += [
-                f"-DCUDNN_FRONTEND_FETCH_PYBINDS_IN_CMAKE=ON",
+                f"-DPython_EXECUTABLE={sys.executable}",
             ]
         else:
             cmake_args += [
