From 9ea65f683bb87727fb5f6432c2f8d4083466fc1e Mon Sep 17 00:00:00 2001
From: Andrew Howe <ahowe@anaconda.com>
Date: Wed, 15 Jul 2026 13:21:36 -0400
Subject: [PATCH] unvendor dependencies: dlpack, pybind

---
 setup.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index ac9ba60..ae28a1d 100644
--- a/setup.py
+++ b/setup.py
@@ -46,11 +46,13 @@ class CMakeBuild(build_ext):
             # All these are handled by pip
             f"-DCMAKE_LIBRARY_OUTPUT_DIRECTORY={extdir}{os.sep}",
             f"-DCUDNN_FRONTEND_KEEP_PYBINDS_IN_BINARY_DIR=OFF",
+            f"-DCUDNN_FRONTEND_USE_SYSTEM_DLPACK=ON",
+            f"-DCUDNN_FRONTEND_FETCH_PYBINDS_IN_CMAKE=OFF",
         ]
 
         if is_windows:
             cmake_args += [
-                f"-DCUDNN_FRONTEND_FETCH_PYBINDS_IN_CMAKE=ON",
+                f"-DPython_EXECUTABLE={sys.executable}",
             ]
         else:
             cmake_args += [
